PORT=5050
API_VERSION=v1
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/bazario?retryWrites=true&w=majority
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Minimum log level: debug | info | notice | error (errors always print to stderr)
LOG_LEVEL=debug
VENDOR_TRIAL_DAYS=14
GST_RATE=0.18
# One-time: npm run seed with SEED_DB=true
SEED_DB=
ADMIN_EMAIL=admin@bazario.local
ADMIN_PASSWORD=admin123
# Google Sign-In (same Web client ID as the frontend REACT_APP_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=
# Password reset: print 6-digit OTP in API logs when true (local dev; use email/SMS in production)
LOG_RESET_OTP=true
# OTP validity in ms (default 15 minutes)
PASSWORD_RESET_OTP_TTL_MS=900000
