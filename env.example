# ─── Server ───────────────────────────────────────────────────────────────────
PORT=
NODE_ENV=          # development | production
MONGO_URI=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true             # true for port 465 (SSL), false for 587 (TLS/STARTTLS)
EMAIL_USER=
EMAIL_PASS=
# JWT
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# Login security
MAX_FAILED_ATTEMPTS=5
LOCK_DURATION_MS=900000
MAX_DEVICES=5